# IntelAssist AI - Environment Configuration Example
# Copy this file to .env and insert your API keys if using cloud providers.
# IntelAssist AI runs 100% offline in Demo Mode without requiring any external keys.

# Google Gemini API Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA NIM API Key (Optional)
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Default Active LLM Provider
DEFAULT_LLM_PROVIDER=Demo Mode (Smart AI)
